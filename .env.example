# Copy to .env (or .env.local) and fill in real values. Real environment
# variables win over .env.local, which wins over .env.
MQTT_BROKER_URL=tcp://mqtt-server:1883
MQTT_CLIENT_ID=dahua-companion
MQTT_USERNAME=dahua
MQTT_PASSWORD=changeme
HOSTNAME_OR_IP=doorbell
DAHUA_USERNAME=admin
DAHUA_PASSWORD=changeme

# Camera API over HTTPS (default http). Cameras use self-signed certificates:
# point DAHUA_CA_FILE at the camera's exported certificate, or, less safely,
# set DAHUA_TLS_INSECURE=true.
#DAHUA_SCHEME=https
#DAHUA_CA_FILE=/run/secrets/camera.pem
#DAHUA_TLS_INSECURE=false

# Optional settings and their defaults:
#MQTT_TOPIC=doorbell/pressed
#MQTT_AVAILABILITY_TOPIC=doorbell/availability
# Human detection events; set to empty (MQTT_HUMAN_TOPIC=) to disable.
#MQTT_HUMAN_TOPIC=doorbell/human
# "empty" (default) or "json" ({"event_type","timestamp","channel"}).
#MQTT_PAYLOAD_FORMAT=empty
#HUMAN_COOLDOWN=10s
# Publish a camera still after these events, to "<event topic>/snapshot".
#SNAPSHOT=press,human
# "request" (default) fetches a still right after the event; "event" uses the
# camera's own still from the moment of the event, where the firmware supports it.
#SNAPSHOT_SOURCE=request
# Unset by default; "homeassistant" matches HA's default discovery prefix.
#MQTT_DISCOVERY_PREFIX=homeassistant
#HEALTH_PORT=8080
# "debug" also logs every camera stream line the app does not handle.
#LOG_LEVEL=info
#APP_ENV=development
