# Copy to .env (or .env.local) and fill in real values. Real environment
# variables win over .env.local, which wins over .env.
MQTT_BROKER_URL=tcp://mqtt-server:1883
MQTT_CLIENT_ID=dahua-companion
MQTT_USERNAME=dahua
MQTT_PASSWORD=changeme
HOSTNAME_OR_IP=doorbell
DAHUA_USERNAME=admin
DAHUA_PASSWORD=changeme

# Optional settings and their defaults:
#MQTT_TOPIC=doorbell/pressed
#MQTT_AVAILABILITY_TOPIC=doorbell/availability
# Unset by default; "homeassistant" matches HA's default discovery prefix.
#MQTT_DISCOVERY_PREFIX=homeassistant
#HEALTH_PORT=8080
#APP_ENV=development
